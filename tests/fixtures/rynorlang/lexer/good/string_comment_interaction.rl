// strings containing comment markers - markers inside strings are ordinary text
let s = "// not a comment";
let t = "/* also not */";
print(s);
// real comment
let u = "hello // still string";
let v = "world /* still string */";
print("/*");
// comment with "string" inside comment // "hello"
let w = "//";
let x = " // ";
print("//");
